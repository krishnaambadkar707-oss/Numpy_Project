{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "memory": 1024,
      "excludeFiles": "{test_*.py,*.wav,*.mp3,*.md,Dockerfile,render.yaml,Procfile,numpy_project.py,runcode.json}"
    }
  }
}
